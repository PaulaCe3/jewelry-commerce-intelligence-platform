# Datasets locales: conservar únicamente los marcadores de directorio.
/data/raw/**
!/data/raw/.gitkeep
/data/processed/**
!/data/processed/.gitkeep

# Línea Aurelia: datos sintéticos, bases y reportes locales; no publicar artefactos.
/data/aurelia/**
.aurelia-*/

